# Build, IDE and live-run output, plus credential-bearing files that must never
# be committed. Project-specific rules are at the bottom.

# Compiled Java class files
*.class

# Log files
*.log

# Package files
*.jar

# Maven
target/

# Other build tools' output and local notes. /notes/ is rooted, so a notes
# directory below the top level stays tracked.
build/
.gradle/
/notes/

# JetBrains IDE
.idea/

# Eclipse and VS Code
.vscode/
.settings/
.classpath
.project

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv


# Local, credential-bearing live drivers, matched by name anywhere under the
# test tree. pom.xml excludes the same pattern from compilation. Not Live*.java,
# which would match the tracked LiveSuite.java.
src/test/**/*Driver.java

# Local working area: parked artifacts, live-test drivers, notes.
/scratchpad/

# Credentials for live verification. Never committed.
.env
.env.*
!.env.example

# Captured live responses: they hold real email, address and phone values.
captures/
sweep_result.json

# The token cache, if tokenCachePath points into the repository: it holds a
# live access token and the client credentials.
token.json
*_token.json

# Maven wrapper output / IDE
.mvn/
*.iml
.cp.txt
