<?xml version="1.0" encoding="UTF-8"?>
<!--
  Exsited Java SDK - a thin, predictable HTTP layer over the Exsited v4 REST API:
  payloads and responses cross the wire untouched as Maps and Lists, or as typed
  views measured from the API; frozen validated configuration; OAuth2 with
  cross-process token caching; retry narrowed on state-changing methods; cursor
  and offset pagination detected per page; secret redaction everywhere.

  Behaviour that must not be changed casually, because live callers and cached
  data depend on it: the pagination walk rules, the query-value normalisation
  table and its refusals, the token-cache file format, the transport semantics
  (401 replay, unsafe-method retry narrowing, X-Idempotency-Key on POST), and the
  empty <dependencies> block.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.exsited</groupId>
    <artifactId>exsited</artifactId>
    <version>4.0.1</version>
    <packaging>jar</packaging>

    <name>Exsited Java SDK</name>
    <description>Java SDK for the Exsited v4 REST API.</description>
    <url>https://github.com/exsited/exsited-sdk-java</url>

    <!-- The licence the LICENSE file at the repository root states, so the
         terms travel with the artifact. -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/exsited/exsited-sdk-java</url>
        <connection>scm:git:https://github.com/exsited/exsited-sdk-java.git</connection>
        <developerConnection>scm:git:https://github.com/exsited/exsited-sdk-java.git</developerConnection>
    </scm>

    <developers>
        <developer>
            <name>Ashiq Rahman</name>
            <email>ashiq@webalive.com.au</email>
            <organization>Exsited</organization>
            <organizationUrl>https://www.exsited.com</organizationUrl>
        </developer>
    </developers>

    <properties>
        <!-- 21: the SDK closes the java.net.http.HttpClient it built, and
             HttpClient is AutoCloseable from JDK 21. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
    </properties>

    <!-- The SDK depends on the JDK and nothing else. -->
    <dependencies/>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <!-- The licence and the consumer guide travel inside the jar, under
             META-INF, so the terms the <licenses> block above states arrive with
             the artifact rather than only with the repository. -->
        <resources>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>LICENSE</include>
                    <include>README.md</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- -Xlint:all with -Werror: any compiler warning fails the build. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- Writes Implementation-Version (and friends) into the jar
                 manifest, which is where SdkConfig.SDK_VERSION and the
                 User-Agent read the version from when packaged. A run over
                 target/classes has no manifest and reports the
                 SdkConfig.FALLBACK_VERSION sentinel (0.0.0+source). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- The sources jar beside the binary one, so an IDE in a consuming
                 project can step into the SDK. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- A wrong @param name, a broken {@link}, malformed HTML or a bad
                 reference fails the build; `-missing` drops only the demand that
                 a doc exist. -Xmaxwarns is raised because javadoc stops counting
                 at 100 by default. Bound to verify. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc.plugin.version}</version>
                <configuration>
                    <show>protected</show>
                    <doclint>all,-missing</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <additionalOptions>
                        <additionalOption>-Xmaxwarns 10000</additionalOption>
                    </additionalOptions>
                </configuration>
                <executions>
                    <execution>
                        <id>strict-public-docs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.9.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>false</autoPublish>
                    <waitUntil>validated</waitUntil>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <activation>
                <property>
                    <name>env.MAVEN_GPG_KEY</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <signer>bc</signer>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
